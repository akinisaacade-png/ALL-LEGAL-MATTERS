rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check email syntax for basic security verification
    function isValidEmail(email) {
      return email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$');
    }
    
    match /subscriptions/{subscriptionId} {
      allow read, write: if subscriptionId != null && subscriptionId != '';
    }
    
    match /users/{userId} {
      allow read, write: if userId != null && userId != '';
    }

    match /documents/{documentId} {
      allow read, write: if documentId != null && documentId != '';
    }

    match /bookings/{bookingId} {
      allow read, write: if bookingId != null && bookingId != '';
    }

    match /jurisdictions_europe_core/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /Europe_subnational/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
